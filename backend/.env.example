# Required for best results (Finnhub is primary data + company news)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional – Railway sets PORT automatically
# PORT=8000

# ARTIFACTS_PATH=./artifacts
DATA_DIR=./data

# Learning state, predictions, and accuracy are written under DATA_DIR.
# On Railway/containers: mount a persistent volume on DATA_DIR or learning resets on redeploy.

# Optional: protect POST /resolve and POST /resolve-due
# RESOLVE_SECRET=long-random-string

# Optional: auto-resolve past-horizon predictions (ms). 86400000 = once per day.
# RESOLVE_DUE_INTERVAL_MS=86400000
# RESOLVE_DUE_LIMIT=20

# Optional legacy NewsAPI (not used by combined sentiment path)
# NEWS_API_KEY=your_newsapi_key_here
