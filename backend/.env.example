# Required for best results (Finnhub is primary data source + company news)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional – Railway sets PORT automatically
# PORT=8000

# Optional overrides
# ARTIFACTS_PATH=./artifacts
# DATA_DIR=./data

# Optional legacy NewsAPI (not used by the new combined sentiment path)
# NEWS_API_KEY=your_newsapi_key_here
