{
  "tasks": {
    "start": "deno run -A --env src/main.ts",
    "dev": "deno run -A --env --watch src/main.ts",
    "cache": "deno cache src/main.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "imports": {
    "oak": "https://deno.land/x/oak@v17.1.3/mod.ts",
    "cors": "https://deno.land/x/cors@v1.2.2/mod.ts"
  }
}
